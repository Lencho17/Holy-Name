<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00000000"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/primary_purple"
            app:title="From the Principal's Desk"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/primary_purple" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/accent_gold">

                <ImageView
                    android:id="@+id/principalPhoto"
                    android:layout_width="200dp"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/school_logo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/principalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="Sr. Maria Goretti"
                android:textColor="@color/primary_purple"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/principalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Principal, Holy Name School"
                android:textColor="@color/accent_gold_dark"
                android:textSize="14sp"
                android:textStyle="italic" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:src="@android:drawable/btn_star_big_on"
                android:alpha="0.2"
                android:layout_gravity="start"/>

            <TextView
                android:id="@+id/principalIntroQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Education is the most powerful weapon which you can use to change the world."
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="italic"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/principalMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Message content goes here..."
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

            <ImageView
                android:id="@+id/principalSignature"
                android:layout_width="150dp"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:layout_gravity="end"
                android:scaleType="fitCenter" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
